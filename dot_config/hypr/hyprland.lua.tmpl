-- Hyprland 0.56+ (Lua config), modelled on i3/sway.
-- i3 layout and keys come from the hy3 plugin, configured in i3.lua.
-- Plugin install (once, from inside Hyprland):
--   hyprpm update && hyprpm add https://github.com/outfoxxed/hy3 && hyprpm enable hy3

local mod = "SUPER"
-- Home row direction keys, like vim
local left, down, up, right = "h", "j", "k", "l"

local term = "ghostty"
local fileManager = "thunar"

local menu = [[rofi -modes "combi,drun,run,window" -combi-modes "drun,run,window" -show combi -icon-theme 'Fluent-dark' -show-icons -combi-hide-mode-prefix -application-fallback-icon application-x-executable]]

-- Alt+Tab: list of all windows in rofi.
-- Tab/Shift+Tab cycle while Alt is held; releasing Alt switches to the selected window.
local switcher = [[rofi -show window -show-icons -icon-theme 'Fluent-dark' -window-format '{t}' -selected-row 1 -kb-accept-entry '!Alt-Tab,!Alt+Alt_L,Return,KP_Enter' -kb-row-down 'Alt+Tab,Down,Control+n' -kb-row-up 'Alt+ISO_Left_Tab,Up,Control+p' -kb-cancel 'Escape,Control+g']]

local function m(keys)
    return mod .. " + " .. keys
end

---- MONITOR ----

-- kanshi handles positions and modes, as in sway: this is only the
-- fallback rule for outputs no profile covers.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

---- ENV ----

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
{{- if not .laptop }}

-- nvidia bullshit
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
{{- end }}

---- AUTOSTART ----

hl.on("hyprland.start", function()
    hl.exec_cmd("command -v hyprpm >/dev/null && hyprpm reload -n")
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("waybar")

    -- Dead keys (AltGr+` e -> è) in Ghostty/GTK4 without ibus/fcitx
    hl.exec_cmd("gsettings set org.gnome.desktop.interface gtk-im-module simple")

    -- Notifications
    hl.exec_cmd("dunst")

    -- Wallpapers: same awww scripts as sway
    hl.exec_cmd("awww-daemon")
    hl.exec_cmd("~/.config/awww/wallpaper-roll.sh ~/wall 3600")

    hl.exec_cmd("kanshi")

    -- Idle: sway's timings, locking with hyprlock (~/.config/hypr/hyprlock.conf).
    -- Goes through logind because hyprlock stays in the foreground until unlocked:
    -- launched directly, swayidle -w would wait for the unlock before suspending.
    hl.exec_cmd([[swayidle -w timeout 300 'loginctl lock-session' timeout 600 "hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'" resume "hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'" before-sleep 'loginctl lock-session' lock 'pidof hyprlock || hyprlock &']])
{{- if not .laptop }}

    hl.exec_cmd("steam -silent")
{{- end }}
end)

-- Like exec_always kanshictl reload: a reload reapplies Hyprland's monitor
-- rules, kanshi puts the right profile back.
hl.on("config.reloaded", function()
    hl.exec_cmd("kanshictl reload")
end)

---- LOOK AND FEEL ----

hl.config({
    general = {
        -- sway's gaps inner 12 / outer 0: in Hyprland gaps_in is per side
        -- and monitor edges only get gaps_out
        gaps_in  = 6,
        gaps_out = 12,

        border_size = 2,
        col = {
            active_border   = "rgba(e0af68ff)", -- Tokyo Night, like client.* in sway
            inactive_border = "rgba(292e42ff)",
        },

        resize_on_border = true,
        allow_tearing    = false,
    },

    decoration = {
        rounding = 6,

        -- default_dim_inactive 0.05
        dim_inactive = true,
        dim_strength = 0.05,

        -- Shadow only on the focused window
        shadow = {
            enabled        = true,
            range          = 4,
            render_power   = 3,
            offset         = { 6, 6 },
            color          = "rgba(00000066)",
            color_inactive = "rgba(00000000)",
        },

        blur = {
            enabled = true,
            size    = 1,
            passes  = 2,
            noise   = 0.02,
        },
    },

    animations = {
        enabled = false,
    },

    misc = {
        force_default_wallpaper  = 0,
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
    },
{{- if not .laptop }}

    cursor = {
        no_hardware_cursors = 1,
    },
{{- end }}

    input = {
        kb_layout  = "us",
        kb_variant = "altgr-intl",

        follow_mouse = 1,
{{- if .laptop }}

        touchpad = {
            natural_scroll          = true,
            middle_button_emulation = true,
        },
{{- else }}

        tablet = {
            output      = "DP-3",
            left_handed = true,
        },
{{- end }}
    },
})

-- rofi effects, like swayfx's layer_effects
hl.layer_rule({ name = "rofi-blur", match = { namespace = "rofi" }, blur = true, ignore_alpha = 0.5 })

---- KEYBINDINGS ----

-- Basics:
hl.bind(m("Return"), hl.dsp.exec_cmd(term))
hl.bind(m("d"), hl.dsp.exec_cmd(menu))
hl.bind("ALT + Tab", hl.dsp.exec_cmd(switcher))
hl.bind(m("t"), hl.dsp.exec_cmd(fileManager))

hl.bind(m("SHIFT + c"), hl.dsp.exec_cmd("hyprctl reload"))

-- Exit Hyprland (logs you out of your Wayland session)
hl.bind(m("SHIFT + e"), hl.dsp.exec_cmd([[swaynag -t warning -m 'This will end your session.' -B 'Yes, exit Hyprland' "hyprctl dispatch 'hl.dsp.exit()'"]]))

-- Move the whole focused workspace to the adjacent output
hl.bind(m("CTRL + " .. left), hl.dsp.workspace.move({ monitor = "l" }))
hl.bind(m("CTRL + " .. right), hl.dsp.workspace.move({ monitor = "r" }))

-- Workspaces (names as in sway)
local workspaceNames = {
    [1] = "1 code",
    [2] = "2 terminals",
    [3] = "3 browser",
    [5] = "5 firefox",
    [9] = "9 ai",
}
for i, name in pairs(workspaceNames) do
    hl.workspace_rule({ workspace = tostring(i), default_name = name })
end
for i = 1, 10 do
    hl.bind(m(i % 10), hl.dsp.focus({ workspace = i }))
end

-- Kill, focus/move, layout: see i3.lua
require("i3")

hl.bind(m("f"), hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }))

-- Toggle the current focus between tiling and floating mode
hl.bind(m("SHIFT + space"), hl.dsp.window.float({ action = "toggle" }))

-- Drag floating windows with mod + LMB, resize with mod + RMB
hl.bind(m("mouse:272"), hl.dsp.window.drag(), { mouse = true })
hl.bind(m("mouse:273"), hl.dsp.window.resize(), { mouse = true })

-- Scratchpad: as in sway, the window becomes floating
hl.bind(m("SHIFT + minus"), function()
    hl.dispatch(hl.dsp.window.float({ action = "enable" }))
    hl.dispatch(hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }))
end)
hl.bind(m("minus"), hl.dsp.workspace.toggle_special("scratchpad"))

-- Resizing containers:
hl.bind(m("r"), hl.dsp.submap("resize"))
hl.define_submap("resize", function()
    local step = 100
    local resizes = {
        [left] = { -step, 0 }, [down] = { 0, step }, [up] = { 0, -step }, [right] = { step, 0 },
        left   = { -step, 0 }, down   = { 0, step }, up   = { 0, -step }, right   = { step, 0 },
    }
    for key, d in pairs(resizes) do
        hl.bind(key, hl.dsp.window.resize({ x = d[1], y = d[2], relative = true }), { repeating = true })
    end
    hl.bind("Return", hl.dsp.submap("reset"))
    hl.bind("Escape", hl.dsp.submap("reset"))
    hl.bind(m("r"), hl.dsp.submap("reset"))
end)

-- Utilities:
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("pactl set-sink-mute @DEFAULT_SINK@ toggle"), { locked = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("pactl set-sink-volume @DEFAULT_SINK@ -5%"), { locked = true, repeating = true })
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("pactl set-sink-volume @DEFAULT_SINK@ +5%"), { locked = true, repeating = true })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("pactl set-source-mute @DEFAULT_SOURCE@ toggle"), { locked = true })

hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true })
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true })
hl.bind("XF86AudioStop", hl.dsp.exec_cmd("playerctl stop"), { locked = true })
{{- if .laptop }}

hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 5%-"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl set 5%+"), { locked = true, repeating = true })

-- Lid closed: turn off the internal screen; lid open: turn it back on and
-- let kanshi reapply the profile
hl.bind("switch:on:Lid Switch", function()
    hl.monitor({ output = "eDP-1", disabled = true })
end, { locked = true })
hl.bind("switch:off:Lid Switch", function()
    hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1 })
    hl.exec_cmd("kanshictl reload")
end, { locked = true })
{{- else }}

hl.bind(m("SHIFT + p"), hl.dsp.exec_cmd("~/.config/hypr/toggle-monitors.sh"))
{{- end }}

-- Notifications
hl.bind(m("n"), hl.dsp.exec_cmd("dunstctl close"))
hl.bind(m("SHIFT + n"), hl.dsp.exec_cmd("dunstctl history-pop"))

-- Random wallpaper right now
hl.bind(m("SHIFT + a"), hl.dsp.exec_cmd("~/.config/awww/wallpaper-random.sh ~/wall"))

-- Print: area -> clipboard | Ctrl+Print: area -> satty
hl.bind("Print", hl.dsp.exec_cmd([[grim -g "$(slurp)" - | wl-copy]]))
hl.bind("CTRL + Print", hl.dsp.exec_cmd([[grim -g "$(slurp)" - | satty -f - --copy-command wl-copy --output-filename ~/Pictures/screenshot-%Y-%m-%d-%H%M%S.png]]))

-- Transparency on all windows: on / off
hl.bind(m("SHIFT + t"), function()
    local opacity = hl.get_config("decoration.active_opacity") < 1 and 1.0 or 0.9
    hl.config({ decoration = { active_opacity = opacity, inactive_opacity = opacity } })
end)

-- Animations: on / off
hl.bind(m("SHIFT + m"), function()
    hl.config({ animations = { enabled = not hl.get_config("animations.enabled") } })
end)

---- WINDOW RULES ----

-- Ignore "maximize" requests from apps, as in i3's tiling
hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

-- Fix some dragging issues with XWayland
hl.window_rule({
    name  = "fix-xwayland-drags",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },
    no_focus = true,
})

-- Rule regexes must match the whole class (in sway a substring is enough)
hl.window_rule({
    name  = "float-calculator",
    match = { class = "(?i).*calculator.*" },
    float = true,
})
