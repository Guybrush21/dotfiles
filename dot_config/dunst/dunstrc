# Tokyo Night — stessa palette di waybar, rofi e bordi di sway.
# Vedi dunst(5) per tutte le opzioni.

[global]
    ### Posizione ###
    # Segue l'output con il focus; allineato alle finestre:
    # 12px dal bordo destro e sotto la waybar (gaps inner): stessa altezza del bordo alto delle finestre.
    follow = keyboard
    origin = top-right
    offset = (12, 12)
    layer = overlay

    width = (300, 420)
    height = (0, 300)
    notification_limit = 5
    indicate_hidden = yes

    ### Aspetto ###
    font = Iosevka Nerd Font Propo 12
    background = "#1a1b26e0"
    foreground = "#c0caf5"
    frame_width = 2
    frame_color = "#3b4261"
    corner_radius = 6
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14

    ### Barra di avanzamento ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 420
    progress_bar_corner_radius = 4
    highlight = "#e0af68"

    ### Testo ###
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icone ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Papirus, Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 4

    ### Cronologia ###
    sticky_history = yes
    history_length = 20

    ### Varie ###
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    frame_color = "#292e42"
    foreground = "#a9b1d6"
    timeout = 5

[urgency_normal]
    frame_color = "#3b4261"
    timeout = 8

[urgency_critical]
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0
    override_pause_level = 60
