# Tokyo Night — same palette as waybar, rofi and sway borders.
# See dunst(5) for all options.

[global]
    ### Position ###
    # Follows the focused output; aligned with the windows:
    # 12px from the right edge and below waybar (gaps inner): same height as the windows' top edge.
    follow = keyboard
    origin = top-right
    offset = (12, 24)
    layer = overlay

    width = (400, 520)
    height = (0, 300)
    notification_limit = 5
    indicate_hidden = yes

    ### Appearance ###
    font = Iosevka Nerd Font Propo 12
    background = "#1a1b26e0"
    foreground = "#c0caf5"
    frame_width = 2
    frame_color = "#3b4261"
    corner_radius = 6
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 420
    progress_bar_corner_radius = 4
    highlight = "#e0af68"

    ### Text ###
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Fluent-dark, Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 4

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    frame_color = "#292e42"
    foreground = "#a9b1d6"
    timeout = 15

[urgency_normal]
    frame_color = "#e0af68"
    timeout = 15

[urgency_critical]
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0
    override_pause_level = 60
