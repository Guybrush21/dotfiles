{
  "font": "sans:size=10",
  "layer": "top",
  "position": "top",
  "margin-top": 12,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],

  "modules-center": ["clock"],

  "modules-right": ["group/controls", "group/monitors", "group/essentials"],

  // Controlli cliccabili
  "group/controls": {
    "orientation": "inherit",
    "modules": [
      "tray",
{{- if .laptop }}
      "network",
      "power-profiles-daemon",
      "backlight",
{{- end }}
    ],
  },

  // Monitor di sistema
  "group/monitors": {
    "orientation": "inherit",
    "modules": [
{{- if not .laptop }}
      "disk#home",
{{- end }}
      "disk",
      "temperature",
      "cpu",
      "memory",
    ],
  },

  // I più usati
  "group/essentials": {
    "orientation": "inherit",
    "modules": [
{{- if .laptop }}
      "battery",
{{- end }}
      "pulseaudio",
      "custom/power",
    ],
  },

  "sway/workspaces": {
    "format": "{name} {icon}",
    "format-icons": {
      "focused": "<span color='#e0af68'></span>",
      "urgent": "<span color='#f7768e'></span>",
      "default": "<span color='#e0af68'></span>",
    },
  },

  "sway/window": {
    "format": "{title}",
    "separate-outputs": true,
  },

  "clock": {
    "format": "<span color='#7dcfff'></span> {:L%a %d %b · %H:%M}",
    "locale": "it_IT.UTF-8",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#7dcfff'><b>{}</b></span>",
        "days": "<span color='#c0caf5'><b>{}</b></span>",
        "weeks": "<span color='#9ece6a'><b>W{}</b></span>",
        "weekdays": "<span color='#e0af68'><b>{}</b></span>",
        "today": "<span color='#f7768e'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "network": {
    "format-wifi": "<span color='#7dcfff'>󰤢</span>",
    "format-ethernet": "<span color='#7dcfff'>󰈀</span> ",
    "format-disconnected": "<span color='#f7768e'>󰤠</span> ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "nm-connection-editor",
  },
  "power-profiles-daemon": {
    "format": "<span color='#bb9af7'>{icon}</span>",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰗑",
      "power-saver": "󰌪",
    },
  },
  "backlight": {
    "format": "<span color='#e0af68'>󰃠</span> {percent}%",
    "tooltip-format": "Luminosità {percent}%",
    "scroll-step": 5,
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "<span color='#9ece6a'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#9ece6a'>󰂄</span> {capacity}%",
    "format-icons": ["", "", "", "", ""],
  },
  "tray": {
    "spacing": 10,
  },
  "temperature": {
    // "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": "<span color='#ff9e64'>{icon}</span> {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
  },
  "cpu": {
    "interval": 1,
    // "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    // "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "format": "<span color='#7aa2f7'></span> {usage: >2}%",
    "on-click": "ghostty -e htop",
  },

  "memory": {
    "interval": 30,
    "format": "<span color='#bb9af7'></span>  {percentage}%",
    "tooltip-format": "Memory",
  },

  "pulseaudio": {
    "format": "<span color='#73daca'>{icon}</span>  {volume}%",
    "format-muted": "<span color='#f7768e'></span>",
    "format-icons": {
      "default": ["", "", " "],
    },
    "on-click": "pavucontrol",
    "scroll-step": 5,
  },
  "disk": {
    "format": "<span color='#e0af68'></span>  / {percentage_used}%",
    "path": "/",
    "interval": 30,
  },
  "disk#home": {
    "format": "<span color='#e0af68'></span>  /home {percentage_used}%",
    "path": "/home",
    "interval": 30,
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
    },
  },
}
